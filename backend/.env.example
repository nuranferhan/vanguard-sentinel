UPSTREAM_GAME_SERVER=http://localhost:9000
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=5.0

AES_SECRET_KEY=change_this_to_a_random_32_char_key
JWT_SECRET=change_this_jwt_secret
JWT_ADMIN_SECRET=change_this_admin_jwt_secret

ANOMALY_MODEL_PATH=app/ai/models/isolation_forest.joblib
